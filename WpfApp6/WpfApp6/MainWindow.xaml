<Window x:Class="WpfApp6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ еды" Height="680" Width="480"
        Style="{StaticResource AppWindow}">

    <StackPanel Margin="20">

        <TextBlock Style="{StaticResource HeaderText}" Text="Заказ еды"/>
        <Button Style="{StaticResource SecondaryButton}"
                Content="Сменить тему"
                HorizontalAlignment="Left"
                Click="btnTheme_Click"/>

        <TextBlock Style="{StaticResource SectionText}" Text="Категория"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="Category" Content="Пицца" IsChecked="True"/>
            <RadioButton GroupName="Category" Content="Бургеры"/>
            <RadioButton GroupName="Category" Content="Десерты" IsEnabled="False"/>
        </StackPanel>

        <TextBlock Style="{StaticResource SectionText}" Text="Блюдо"/>
        <ComboBox SelectedIndex="0">
            <ComboBoxItem Content="Маргарита"/>
            <ComboBoxItem Content="Пепперони"/>
            <ComboBoxItem Content="Четыре сыра"/>
        </ComboBox>

        <TextBlock Style="{StaticResource SectionText}" Text="Дополнительно"/>
        <CheckBox Content="Двойная порция" IsChecked="True"/>
        <CheckBox Content="Сырный соус"/>

        <TextBlock Style="{StaticResource SectionText}" Text="Данные заказа"/>
        <TextBox/>
        <TextBox Style="{StaticResource MultilineTextBox}"/>

        <TextBlock Style="{StaticResource SectionText}" Text="Корзина"/>
        <ProgressBar Minimum="0" Maximum="100" Value="60"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Добавить"/>
            <Button Style="{StaticResource DangerButton}" Content="Отменить"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Оплатить" IsEnabled="False"/>
        </StackPanel>

    </StackPanel>
</Window>