<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1A17"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3E9DF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#332C27"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#5C4E42"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#FF8A3D"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF9F5E"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#E5732A"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1E1A17"/>

    <SolidColorBrush x:Key="SecondaryBrush" Color="#3B322B"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#4A3F36"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#F06267"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#C73A3F"/>
    <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#332E2A"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#6F655B"/>
</ResourceDictionary>